# ---------------------------------------------------------------
# VeriAgent configuration. Copy to .env and fill in your key.
# ---------------------------------------------------------------

# Provider: gemini | groq | openai | ollama | mock
LLM_PROVIDER=gemini

# API keys (only the one for your provider is needed)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Models. Defaults per provider are used when these are empty.
#   gemini : gemini-2.5-flash            (text and vision)
#   groq   : llama-3.3-70b-versatile     / meta-llama/llama-4-scout-17b-16e-instruct (vision)
#   openai : gpt-4o-mini                 (text and vision)
#   ollama : llama3.1:8b                 / llama3.2-vision
TEXT_MODEL=
VISION_MODEL=

# Generation settings
TEMPERATURE=0
MAX_RETRIES=3

# Evidence memory backend: auto | chroma | tfidf
EVIDENCE_BACKEND=auto

# Wait between LLM calls in seconds (helps with free-tier rate limits)
REQUEST_DELAY=0
